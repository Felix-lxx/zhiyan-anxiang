# PostgreSQL
POSTGRES_DB=zhiyan_anxiang
POSTGRES_USER=zhiyan
POSTGRES_PASSWORD=zhiyan_local_only
POSTGRES_PORT=5432

# FastAPI development-only bootstrap account
APP_ENV=development
JWT_SECRET=replace-this-before-any-non-development-run
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PARTICIPANT_INVITE_HOURS=8
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Zhiyan@2026
BACKEND_PORT=8000

# Vite
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
# 后端 CORS 默认同时允许 http://localhost:5173 与 http://127.0.0.1:5173
# 非 development 环境必须明确设置 HTTPS 域名；不再开放整个内网地址段。
# CORS_ORIGINS=https://training.example.org

# 场景助手：默认不向外部发送数据。配置后重启后端，并在助手中勾选模型授权。
# offline / compatible（/chat/completions）/ ollama（/api/chat）
ASSISTANT_PROVIDER=compatible
ASSISTANT_BASE_URL=https://api.deepseek.com
ASSISTANT_MODEL=deepseek-v4-flash
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=60
